# NewsLens AI Backend Service Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Security & CORS
# Comma-separated origins for local Expo development
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Database (PostgreSQL via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/newslens?schema=public"

# AI / NLP Engine Microservice URL
AI_ENGINE_URL=http://localhost:8000
