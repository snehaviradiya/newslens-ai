# NewsLens AI Mobile Client Environment Variables

# Base URL for the NewsLens AI Backend Service
# For iOS Simulator:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# For Android Emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# For Physical Android / iOS Device on local Wi-Fi:
# Replace <YOUR_LOCAL_IP> with your machine's LAN IP (e.g., 192.168.1.50)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
